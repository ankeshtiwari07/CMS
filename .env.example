# ============================================================
# HUMAIN Payload CMS — Environment (copy to .env and fill in)
# Real, no-mock defaults. KSA region. Claude-only AI generation.
# ============================================================

# ---- Core ----
NODE_ENV=development
APP_BASE_URL=http://localhost:3000        # public web
CMS_BASE_URL=http://localhost:3001        # Payload headless backend (+ break-glass admin at /admin)
STUDIO_BASE_URL=http://localhost:3002     # custom front-end console (Studio + Content Management)
AI_SERVICE_URL=http://localhost:4000
MCP_SERVER_URL=http://localhost:4100

# ---- Host port mappings for the local docker stack (avoid clashes with other local/VM services) ----
PG_HOST_PORT=5433
REDIS_HOST_PORT=6380
OPENSEARCH_HOST_PORT=9201
MINIO_HOST_PORT=9100
MINIO_CONSOLE_HOST_PORT=9101

# ---- PostgreSQL (+pgvector) ----
# Local dev (node on host) talks to the remapped host port; in-container services use postgres:5432.
DATABASE_URI=postgres://humain:humain@localhost:5433/humain
# Local multilingual (EN+AR) embedding model dimension — see ai-service. Sovereign, no external key.
PGVECTOR_DIM=384

# ---- Redis ----
REDIS_URL=redis://localhost:6380

# ---- OpenSearch ----
OPENSEARCH_URL=http://localhost:9201
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=Humain_2026!

# ---- Payload ----
PAYLOAD_SECRET=change-me-32-chars-minimum-secret-value
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001
SEED_ADMIN_PASSWORD=ChangeMe_2026!
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
CSRF_ORIGINS=http://localhost:3000,http://localhost:3002

# ---- LLM Providers (multi-model: users pick from the model menu) ----
# Default provider for the versioned-prompt /run endpoint + RAG.
LLM_PROVIDER=anthropic
# Each model in the menu lights up only when its provider key is set; the rest
# show "key needed" and stay greyed. Embeddings always run locally (sovereign).

# Claude (Anthropic)
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001

# GPT (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Grok (xAI)
XAI_API_KEY=
XAI_MODEL=grok-4

# Gemini (Google) — uses Google's OpenAI-compatible endpoint
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-pro

# Embeddings run locally in ai-service via @xenova/transformers (no external key, sovereign).
EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2

# ---- Auth: local email+password now (OIDC-ready seam) ----
SESSION_SECRET=another-32-char-minimum-secret-value
# OIDC (disabled until OIDC_ENABLED=true)
OIDC_ENABLED=false
OIDC_ISSUER=https://idp.example.ksa/realms/humain
OIDC_CLIENT_ID=humain-cms
OIDC_CLIENT_SECRET=REPLACE_ME
OIDC_REDIRECT_URI=http://localhost:3001/api/auth/callback

# ---- Object storage (S3-compatible, KSA). Leave S3_ENDPOINT empty for local-disk uploads ----
S3_ENDPOINT=
S3_REGION=me-central-1
S3_BUCKET=humain-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ---- Webhooks / Event bus ----
WEBHOOK_HMAC_SECRET=webhook-hmac-secret-change-me
WEBHOOK_TARGETS=

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=humain-platform

# ---- Locales / Data residency ----
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,ar
DATA_REGION=ksa

# --- Video rendering (text-to-video, optional) ---
# Set these to enable real MP4 rendering in Create Video (e.g. a Replicate model).
VIDEO_PROVIDER=replicate
VIDEO_API_KEY=
VIDEO_MODEL_VERSION=

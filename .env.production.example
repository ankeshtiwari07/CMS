# Copy to .env.production on the VM (gitignored). Shared by all app services.
NODE_ENV=production

# --- Internal service URLs (docker network names) ---
DATABASE_URI=postgres://humain:CHANGE_ME_DB@postgres:5432/humain
POSTGRES_PASSWORD=CHANGE_ME_DB
REDIS_URL=redis://redis:6379
CMS_BASE_URL=http://cms:3001
AI_SERVICE_URL=http://ai-service:4000
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=Humain_2026!

# --- Payload ---
PAYLOAD_SECRET=CHANGE_ME_32_CHARS_MINIMUM_SECRET_VALUE
PAYLOAD_PUBLIC_SERVER_URL=http://cms:3001
DB_PUSH=true                      # bootstrap schema on first boot; set false after migrations exist
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN

# --- Public origin (set to the nginx host:port or domain) ---
# Used for CORS/CSRF. e.g. http://34-x-x-x.sslip.io:8020
APP_PUBLIC_ORIGIN=http://localhost:8020
CORS_ORIGINS=http://localhost:8020
CSRF_ORIGINS=http://localhost:8020
COOKIE_SECURE=false               # set true once TLS is terminated

# --- AI (Claude) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
PGVECTOR_DIM=384

# --- Webhooks ---
WEBHOOK_HMAC_SECRET=CHANGE_ME_HMAC
WEBHOOK_TARGETS=

# --- Object storage (leave S3_ENDPOINT empty for local-disk; set for MinIO/full) ---
S3_ENDPOINT=
S3_REGION=me-central-1
S3_BUCKET=humain-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- Locales ---
SUPPORTED_LOCALES=en,ar
DEFAULT_LOCALE=en

# --- Host port nginx publishes ---
HUMAIN_HTTP_PORT=8020
